OPENROUTER_API_KEY=
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Require an X-API-Key header on /analyze* when set. Leave blank to disable auth
# (safe only while the API is container-internal, as in the single-container deploy).
FINSIGHT_API_KEY=

PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
CHROMA_PERSIST_DIR=./data/chroma
LOG_LEVEL=INFO

# RAGAS evaluation judge backend: "openrouter" (default) or "ollama" (local)
RAGAS_JUDGE_PROVIDER=openrouter

# SEC EDGAR User-Agent (required by SEC; identify your own app/contact here)
SEC_EDGAR_USER_AGENT=FinSightAI research@example.com